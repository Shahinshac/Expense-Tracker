# ==========================================
# FinStudent — Environment Configuration (.env.example)
# ==========================================

# ----------------------------------------------------
# 1. Backend Security & JWT
# ----------------------------------------------------
# Generate a strong 32+ character random secret for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-minimum-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------------
# 2. Database (Supabase PostgreSQL or Local SQLite)
# ----------------------------------------------------
# For local development (SQLite):
DATABASE_URL=sqlite:///./expense_tracker.db

# For Supabase PostgreSQL (Production):
# Replace [PASSWORD] and [PROJECT_REF] with your Supabase credentials:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Or if using Supabase Transaction Pooler (recommended for serverless):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# ----------------------------------------------------
# 3. Supabase Storage (Receipt Attachments - Optional)
# ----------------------------------------------------
# Your Supabase Project URL:
SUPABASE_URL=https://your-project-id.supabase.co

# Backend Supabase API Key (Keep server-side ONLY! Never expose in frontend):
# Use either the Anon key or Service Role key depending on your bucket RLS:
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Storage Bucket Name:
SUPABASE_STORAGE_BUCKET=receipts

# Maximum upload file size in Megabytes (default: 5MB):
MAX_UPLOAD_SIZE_MB=5

# ----------------------------------------------------
# 4. CORS Allowed Origins
# ----------------------------------------------------
# Your deployed frontend URL on Vercel (comma-separated if multiple):
FRONTEND_URL=https://your-finstudent-app.vercel.app

# ----------------------------------------------------
# 5. Frontend Environment Variables (Vercel / Local)
# ----------------------------------------------------
# Leave empty or set to /api/v1 for local development (uses Vite proxy).
# In Vercel production deployment, set to your deployed backend URL:
# VITE_API_URL=https://your-finstudent-api.onrender.com
VITE_API_URL=
